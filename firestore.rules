rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso liberado apenas para usuários autenticados (Firebase Auth
    // email/senha). O app não é multi-tenant: todo usuário autenticado
    // enxerga a mesma frota.
    match /equipamentos/{id} {
      allow read, write: if request.auth != null;
    }

    match /obras/{id} {
      allow read, write: if request.auth != null;
    }

    match /alocacoes/{id} {
      allow read, write: if request.auth != null;
    }

    // Nega qualquer outra coleção por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
